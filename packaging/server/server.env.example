# /etc/munder-difflin/server.env — read by the systemd unit (and usable as a
# docker --env-file). Restart after editing: systemctl restart munder-difflin

# The office: hive, roster, agents' worktrees.
MD_OFFICE=/srv/office
# This office's name as your teammates see it.
MD_NAME=Build server
# One-time invite from your desktop (Pro → Team → Invite). Used once, then
# remembered; leaving it here is harmless.
#MD_TEAM_JOIN=mdteam1....
# Credentials for a private relay — MQTT user:password or an ntfy token:
# <relay>=<token>, comma-separated for several. Moved to the encrypted store.
#MD_RELAY_TOKEN=mqtts://mqtt.example.com:8883=office:password
# At most this many workers at once (the orchestrator and durable agents aside).
MD_MAX_WORKERS=4

# Agents run as this user (created by install.sh). Their CLIs keep logins in
# its home: sudo -u agent -H claude   (then /login)
MD_AGENT_UID=
MD_AGENT_GID=
MD_AGENT_HOME=/home/agent
MD_AGENT_USER=agent

# Or an API key for the agents instead of a login. This one IS visible to
# agents (it is theirs to use); keys for Connections go in the secret store.
#ANTHROPIC_API_KEY=
